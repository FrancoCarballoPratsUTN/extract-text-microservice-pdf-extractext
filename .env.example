# Plantilla de configuracion del microservicio `extract`.
#
#   cp .env.example .env && set -a && source .env && set +a
#
# Las lineas comentadas NO se definen: son las que el servicio ya resuelve
# solo (auto-detectadas). Borralas para sobreescribir un valor concreto.
#
# Ojo: una linea con clave y valor vacio SI define una variable vacia y el
# servicio no arranca. Para dejar sin definir, comentala.

# Puerto que escucha la imagen Docker y el que rutea Traefik.
EXTRACT_BIND_ADDR=0.0.0.0:8000

# Tope del body crudo de POST /extract. Excederlo devuelve 413.
EXTRACT_BODY_LIMIT_BYTES=15728640

# Tope de bytes descomprimidos por PDF. Frena los zip-bombs.
EXTRACT_MAX_DECOMPRESSED_BYTES=67108864

# Extractor de texto: `lean` (rapido, default) u `lopdf` (referencia/rollback).
EXTRACT_EXTRACTOR=lean

# Hilos del pool de rayon. Vacio = available_parallelism() del contenedor.
# EXTRACT_NUM_THREADS=

RUST_LOG=info
